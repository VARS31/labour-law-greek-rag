# Copy to .env and set a password. .env is gitignored.

# Postgres in Docker (docker-compose.yml). Port 5433, because Postgres.app uses 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=labourlaw
POSTGRES_USER=labourlaw
POSTGRES_PASSWORD=change-me

# Ollama (local). EMBED_MODEL makes the vectors in the chunks table (labour_rag.load), so its size must match EMBED_DIM
# and the vector(1024) column in sql/003_chunks.sql. Search uses qwen3-embedding:4b by default, in its own table: see
# labour_rag/embeddings.py. Don't put that model here.
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024
EMBED_BATCH=16

# The model that writes the answers. CHAT_NUM_CTX is the context window Ollama gives it (prompt + answer):
# 8 chunks of up to 500 words need about 12,000 tokens. The seed makes answers repeatable.
CHAT_MODEL=ministral-3:8b
CHAT_TEMPERATURE=0.2
CHAT_NUM_CTX=16384
CHAT_SEED=42

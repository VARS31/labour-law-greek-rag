# Copy to .env and set a password. .env is gitignored.

# Postgres in Docker (docker-compose.yml). Port 5433, because Postgres.app uses 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=labourlaw
POSTGRES_USER=labourlaw
POSTGRES_PASSWORD=change-me

# Ollama (local). The embedding model is swappable, but its vector size must match EMBED_DIM and the
# vector(1024) column in sql/003_chunks.sql.
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024
EMBED_BATCH=16
